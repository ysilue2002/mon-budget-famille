# Mon Budget Famille — variables d'environnement (aucun secret dans le code source)

# --- Frontend (Vite : préfixe VITE_) ---
# API de taux de change sans clé d'API (doit renvoyer { base_code, rates: { USD: 1, XOF: ..., ... } })
VITE_RATES_API_URL=https://open.er-api.com/v6/latest/USD
# URL de l'API backend (laisser vide pour utiliser le proxy Vite /api en développement)
VITE_API_BASE_URL=

# --- Backend (server/.env) ---
# PORT=4000
# DATABASE_URL=postgres://user:password@localhost:5432/mon_budget_famille
# JWT_SECRET=changez-moi-en-production
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=http://localhost:5173
# Rates API (même format que ci-dessus)
# RATES_API_URL=https://open.er-api.com/v6/latest/USD
