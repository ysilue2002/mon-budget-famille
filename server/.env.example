# Backend — variables d'environnement (copier en .env)
PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/mon_budget_famille
# Obligatoire (32 caractères minimum) : générer avec `openssl rand -base64 48`.
# Le serveur refuse de démarrer si ce secret est absent ou trop court.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Liste blanche, séparée par des virgules. Vide = uniquement localhost:5173.
CORS_ORIGIN=http://localhost:5173
RATES_API_URL=https://open.er-api.com/v6/latest/USD

# Purge périodique de l'historique de synchronisation (change_log, processed_ops) :
# premier passage 1 minute après le démarrage, puis toutes les 6 heures.
# Rétention serveur : 90 jours (constante RETENTION_DAYS dans src/db/purge.ts).
# PURGE_FIRST_DELAY_MS=60000
# PURGE_INTERVAL_MS=21600000
