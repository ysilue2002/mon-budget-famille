// Développement local : `npm run dev` (Wrangler + D1 locale, aucun compte Cloudflare requis).
// En production, le déploiement passe par sites-manifest.json (Freebuff Sites).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistant-commercial",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assistant-commercial",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
