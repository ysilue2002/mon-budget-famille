// Développement local : `npm run dev` (Wrangler + D1 locale, aucun compte Cloudflare requis).
// En production, le déploiement passe par sites-manifest.json (Freebuff Sites).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistant-commercial",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Sans ça, en développement, le repli vers index.html répond aux navigations
    // vers /f/<jeton> : la facture ne s'affiche jamais dans un navigateur local,
    // alors qu'en production le Worker passe bien en premier.
    // Les pages passent aussi par le Worker en développement : sans cela les
    // en-têtes de sécurité (CSP de /admin, HSTS) n'apparaîtraient qu'en
    // production, et un contrôle local ne prouverait rien.
    "run_worker_first": ["/f/*", "/api/*", "/", "/index.html", "/admin", "/admin.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assistant-commercial",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
}
